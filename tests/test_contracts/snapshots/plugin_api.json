          "kind": "POSITIONAL_OR_KEYWORD",
          "name": "self"
        },
        {
          "kind": "VAR_POSITIONAL",
          "name": "args"
        },
        {
          "kind": "VAR_KEYWORD",
          "name": "kwargs"
        }
